{
  "id": "/",
  "name": "Scuttlesaurus",
  "short_name": "Scuttlesaurus",
  "description": "A personal Nostr node: relay, client and media server for your social neighbourhood.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f4ee",
  "theme_color": "#1f7a5c",
  "categories": ["social", "news"],
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "New note", "url": "/share", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Write an article", "url": "/write", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reads", "url": "/reads", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  }
}
